    [
     [
      "Volume of the cylinder = &pi; &times; 7<sup>2</sup> &times; 20 = 980&pi; = 3078.76&hellip; cm<sup>3</sup>",
      ""
     ],
     [
      "Volume of the hemisphere = <sup>1</sup>\u2044<sub>2</sub> &times; <sup>4</sup>\u2044<sub>3</sub> &times; &pi; &times; 7<sup>3</sup> = <sup>686</sup>\u2044<sub>3</sub>&pi; = 718.377&hellip; cm<sup>3</sup>",
      ""
     ],
     [
      "Total = 3078.76&hellip; + 718.377&hellip; = 3797.13&hellip;",
      ""
     ],
     [
      "Volume = <b>3800 cm<sup>3</sup></b> (3 s.f.)",
      ""
     ]
