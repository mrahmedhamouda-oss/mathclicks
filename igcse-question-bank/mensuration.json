     [
      "Three rectangles: perimeter &times; length = (6 + 8 + 10) &times; 15 = 24 &times; 15 = 360 cm<sup>2</sup>",
      ""
     ],
     [
      "Total surface area = 48 + 360 = <b>408 cm<sup>2</sup></b>",
      ""
     ]
    ]
   ]
