    [
     [
      "The hypotenuse of the cross-section is &radic;(6<sup>2</sup> + 8<sup>2</sup>) = &radic;100 = 10 cm.",
      "Pythagoras' theorem"
     ],
     [
      "Two triangular ends: 2 &times; 24 = 48 cm<sup>2</sup>",
      ""
