  "title": "Operations on Functions",
  "curriculumModule": "Module 6: Inverses and Radical Functions",
  "satDomain": "Advanced Math",
  "published": true,
  "questions": [
    {
      "type": "mcq",
      "prompt": "If f(x) = 3x and g(x) = x − 4, find (f + g)(x).",
      "choices": [
        "4x − 4",
        "3x − 4",
        "4x + 4",
        "2x − 4"
      ],
      "answer": "A",
      "explanation": "3x + (x − 4) = 4x − 4."
    },
    {
      "type": "mcq",
      "prompt": "If f(x) = x² + 1 and g(x) = 2x, find (f − g)(x).",
      "choices": [
        "x² + 2x + 1",
        "x² − 2x + 1",
        "x² − 2x − 1",
        "−x² + 2x − 1"
      ],
      "answer": "B",
      "explanation": "(x² + 1) − 2x = x² − 2x + 1."
    },
    {
      "type": "mcq",
      "prompt": "If f(x) = x + 2 and g(x) = x − 2, find (f · g)(x).",
      "choices": [
        "x² − 4",
        "x² + 4",
        "2x",
        "x² − 4x + 4"
      ],
      "answer": "A",
      "explanation": "(x + 2)(x − 2) = x² − 4, the difference of squares."
    },
    {
      "type": "mcq",
      "prompt": "If f(x) = x² − 9 and g(x) = x + 3, find (f/g)(x).",
      "choices": [
        "x − 3, x ≠ 3",
        "x + 3, x ≠ −3",
        "x − 3, x ≠ −3",
        "x − 3, no restriction"
      ],
      "answer": "C",
      "explanation": "(x² − 9)/(x + 3) = (x + 3)(x − 3)/(x + 3) = x − 3. The value x = −3 stays excluded even though the factor cancels."
    },
    {
      "type": "mcq",
      "prompt": "The notation [f ∘ g](x) means:",
      "choices": [
        "g[f(x)]",
        "f(x) · g(x)",
        "f[g(x)]",
        "f(x) + g(x)"
      ],
      "answer": "C",
      "explanation": "[f ∘ g](x) = f[g(x)]: evaluate g first, then use that output as the input of f."
    },
    {
      "type": "mcq",
      "prompt": "If f(x) = 2x and g(x) = x + 5, find [f ∘ g](x).",
      "choices": [
        "2x + 10",
        "2x + 5",
        "x + 10",
        "2x² + 10x"
      ],
      "answer": "A",
      "explanation": "f[g(x)] = f(x + 5) = 2(x + 5) = 2x + 10."
    },
    {
      "type": "mcq",
      "prompt": "If f(x) = 2x and g(x) = x + 5, find [g ∘ f](x).",
      "choices": [
        "2x + 10",
        "2x + 5",
        "x + 10",
        "2x − 5"
      ],
      "answer": "B",
      "explanation": "g[f(x)] = g(2x) = 2x + 5. Note this differs from [f ∘ g](x) = 2x + 10."
    },
    {
      "type": "mcq",
      "prompt": "If f(x) = x² and g(x) = x − 1, find [f ∘ g](x).",
      "choices": [
        "x² − 1",
        "x² − 2x + 1",
        "x² + 2x + 1",
        "x² − 2x − 1"
      ],
      "answer": "B",
      "explanation": "f[g(x)] = (x − 1)² = x² − 2x + 1."
    },
    {
      "type": "mcq",
      "prompt": "If f(x) = x + 3 and g(x) = x², find [g ∘ f](x).",
      "choices": [
        "x² + 3",
        "x² + 9",
        "x² + 6x + 9",
        "x² + 3x"
      ],
      "answer": "C",
      "explanation": "g[f(x)] = (x + 3)² = x² + 6x + 9."
    },
    {
      "type": "mcq",
      "prompt": "Is [f ∘ g](x) always equal to [g ∘ f](x)?",
      "choices": [
        "Yes, composition is commutative",
        "No, the order changes the result in general",
        "Only when both are quadratic",
        "Only when both have the same domain"
      ],
      "answer": "B",
      "explanation": "Composition is not commutative. It is equal only in special cases, such as when f and g are inverses."
    },
    {
      "type": "mcq",
      "prompt": "For f(x) = 4x² − 2x + 3 and g(x) = −x + 5, which value must be excluded from (f/g)(x)?",
      "choices": [
        "x = −5",
        "x = 0",
        "x = 5",
        "x = 3"
      ],
      "answer": "C",
      "explanation": "Set the denominator to zero: −x + 5 = 0 gives x = 5."
    },
    {
      "type": "mcq",
      "prompt": "If f(x) = −x² + 3x + 1 and g(x) = 2x² − 5, find (f + g)(x).",
      "choices": [
        "x² + 3x − 4",
        "−3x² + 3x + 6",
        "x² + 3x + 6",
        "3x² + 3x − 4"
      ],
      "answer": "A",
      "explanation": "(−x² + 2x²) + 3x + (1 − 5) = x² + 3x − 4."
    },
    {
      "type": "mcq",
      "prompt": "If f(x) = −x² + 3x + 1 and g(x) = 2x² − 5, find (f − g)(x).",
      "choices": [
        "x² + 3x − 4",
        "−3x² + 3x + 6",
        "−3x² + 3x − 4",
        "−x² + 3x + 6"
      ],
      "answer": "B",
      "explanation": "−x² + 3x + 1 − 2x² + 5 = −3x² + 3x + 6. The −5 becomes +5."
    },
    {
      "type": "mcq",
      "prompt": "Given f = {(1, 5), (2, 7)} and g = {(0, 1), (3, 2)}, find [f ∘ g](0).",
      "choices": [
        "1",
        "5",
        "7",
        "undefined"
      ],
      "answer": "B",
      "explanation": "g(0) = 1, then f(1) = 5."
    },
    {
      "type": "mcq",
      "prompt": "If f(x) = x² + 2x − 8 and g(x) = x² + 8, find (f ∘ g)(x).",
      "choices": [
        "x⁴ + 16x² + 2x + 56",
        "x⁴ + 18x² + 72",
        "x⁴ + 16x² + 56",
        "x⁴ + 18x² + 56"
      ],
      "answer": "B",
      "explanation": "(x² + 8)² + 2(x² + 8) − 8 = x⁴ + 16x² + 64 + 2x² + 16 − 8 = x⁴ + 18x² + 72."
    }
  ],
  "lessonHtml": "lessons/6-1.html"
}
