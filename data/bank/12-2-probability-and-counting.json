{
 "id": "12-2-probability-and-counting",
 "lessonCode": "12.2",
 "title": "Probability and Counting",
 "questions": [
  {
   "type": "mcq",
   "difficulty": "easy",
   "prompt": "The probability of an event is:",
   "choices": [
    "$\\dfrac{\\text{favorable outcomes}}{\\text{total outcomes}}$",
    "$\\dfrac{\\text{total outcomes}}{\\text{favorable outcomes}}$",
    "favorable $\\times$ total",
    "total $-$ favorable"
   ],
   "answer": "A",
   "explanation": "For equally likely outcomes, probability is favorable over possible."
  },
  {
   "type": "mcq",
   "difficulty": "easy",
   "prompt": "A probability must always be:",
   "choices": [
    "between $0$ and $1$",
    "greater than $1$",
    "a whole number",
    "negative or positive"
   ],
   "answer": "A",
   "explanation": "$0$ means impossible and $1$ means certain."
  },
  {
   "type": "mcq",
   "difficulty": "easy",
   "prompt": "What is the probability of rolling a $4$ on a standard die?",
   "choices": [
    "$\\dfrac{1}{6}$",
    "$\\dfrac{1}{4}$",
    "$\\dfrac{4}{6}$",
    "$\\dfrac{1}{2}$"
   ],
   "answer": "A",
   "explanation": "One favorable outcome out of six."
  },
  {
   "type": "mcq",
   "difficulty": "easy",
   "prompt": "What is the probability of rolling an even number on a standard die?",
   "choices": [
    "$\\dfrac{1}{2}$",
    "$\\dfrac{1}{3}$",
    "$\\dfrac{1}{6}$",
    "$\\dfrac{2}{3}$"
   ],
   "answer": "A",
   "explanation": "$\\{2,4,6\\}$ gives $\\dfrac{3}{6} = \\dfrac{1}{2}$."
  },
  {
   "type": "mcq",
   "difficulty": "easy",
   "prompt": "The COMPLEMENT of event $A$ consists of:",
   "choices": [
    "all outcomes NOT in $A$",
    "all outcomes in $A$",
    "the outcomes in both $A$ and $B$",
    "the most likely outcome"
   ],
   "answer": "A",
   "explanation": "$P(\\text{not } A) = 1 - P(A)$."
  },
  {
   "type": "mcq",
   "difficulty": "medium",
   "prompt": "If $P(A) = 0.3$, what is $P(\\text{not } A)$?",
   "choices": [
    "$0.7$",
    "$0.3$",
    "$1.3$",
    "$0$"
   ],
   "answer": "A",
   "explanation": "$1 - 0.3 = 0.7$."
  },
  {
   "type": "mcq",
   "difficulty": "medium",
   "prompt": "The INTERSECTION $A \\cap B$ contains outcomes that are:",
   "choices": [
    "in both $A$ and $B$",
    "in $A$ or $B$ or both",
    "in neither",
    "only in $A$"
   ],
   "answer": "A",
   "explanation": "Intersection means AND — the overlap."
  },
  {
   "type": "mcq",
   "difficulty": "medium",
   "prompt": "The UNION $A \\cup B$ contains outcomes that are:",
   "choices": [
    "in $A$, in $B$, or in both",
    "only in both",
    "in neither",
    "only in $A$"
   ],
   "answer": "A",
   "explanation": "Union means OR, counting the overlap once."
  },
  {
   "type": "mcq",
   "difficulty": "medium",
   "prompt": "Drawing one card from a standard deck, what is $P(\\text{heart})$?",
   "choices": [
    "$\\dfrac{1}{4}$",
    "$\\dfrac{1}{13}$",
    "$\\dfrac{1}{52}$",
    "$\\dfrac{1}{2}$"
   ],
   "answer": "A",
   "explanation": "$\\dfrac{13}{52} = \\dfrac{1}{4}$."
  },
  {
   "type": "mcq",
   "difficulty": "medium",
   "prompt": "Drawing one card, what is $P(\\text{king})$?",
   "choices": [
    "$\\dfrac{1}{13}$",
    "$\\dfrac{1}{4}$",
    "$\\dfrac{4}{13}$",
    "$\\dfrac{1}{52}$"
   ],
   "answer": "A",
   "explanation": "$\\dfrac{4}{52} = \\dfrac{1}{13}$."
  },
  {
   "type": "mcq",
   "difficulty": "hard",
   "prompt": "Drawing one card, what is $P(\\text{king AND heart})$?",
   "choices": [
    "$\\dfrac{1}{52}$",
    "$\\dfrac{1}{13}$",
    "$\\dfrac{4}{13}$",
    "$\\dfrac{1}{4}$"
   ],
   "answer": "A",
   "explanation": "Only the king of hearts satisfies both."
  },
  {
   "type": "mcq",
   "difficulty": "hard",
   "prompt": "Drawing one card, what is $P(\\text{king OR heart})$?",
   "choices": [
    "$\\dfrac{16}{52}$",
    "$\\dfrac{17}{52}$",
    "$\\dfrac{13}{52}$",
    "$\\dfrac{4}{52}$"
   ],
   "answer": "A",
   "explanation": "$\\dfrac{4}{52} + \\dfrac{13}{52} - \\dfrac{1}{52} = \\dfrac{16}{52}$ — subtract the overlap so the king of hearts is not counted twice."
  },
  {
   "type": "mcq",
   "difficulty": "medium",
   "prompt": "The Addition Rule for any two events is:",
   "choices": [
    "$P(A \\cup B) = P(A) + P(B) - P(A \\cap B)$",
    "$P(A \\cup B) = P(A) + P(B)$",
    "$P(A \\cup B) = P(A)P(B)$",
    "$P(A \\cup B) = P(A) - P(B)$"
   ],
   "answer": "A",
   "explanation": "The overlap would otherwise be counted twice."
  },
  {
   "type": "mcq",
   "difficulty": "medium",
   "prompt": "Two events are MUTUALLY EXCLUSIVE when:",
   "choices": [
    "they cannot happen at the same time",
    "they always happen together",
    "one causes the other",
    "they have equal probability"
   ],
   "answer": "A",
   "explanation": "Then $P(A \\cap B) = 0$ and the Addition Rule simplifies to $P(A)+P(B)$."
  },
  {
   "type": "mcq",
   "difficulty": "hard",
   "prompt": "A bag has $5$ red and $3$ blue marbles. What is $P(\\text{red})$?",
   "choices": [
    "$\\dfrac{5}{8}$",
    "$\\dfrac{5}{3}$",
    "$\\dfrac{3}{8}$",
    "$\\dfrac{1}{5}$"
   ],
   "answer": "A",
   "explanation": "$5$ favorable out of $8$ total."
  },
  {
   "type": "mcq",
   "difficulty": "hard",
   "prompt": "Using the same bag, what is $P(\\text{not blue})$?",
   "choices": [
    "$\\dfrac{5}{8}$",
    "$\\dfrac{3}{8}$",
    "$\\dfrac{1}{2}$",
    "$\\dfrac{8}{5}$"
   ],
   "answer": "A",
   "explanation": "Not blue means red: $1 - \\dfrac{3}{8} = \\dfrac{5}{8}$."
  },
  {
   "type": "mcq",
   "difficulty": "hard",
   "prompt": "In a class of $30$, $18$ play football, $12$ play basketball and $5$ play both. How many play at least one?",
   "choices": [
    "$25$",
    "$30$",
    "$35$",
    "$20$"
   ],
   "answer": "A",
   "explanation": "$18 + 12 - 5 = 25$ — the Addition Rule for counts."
  },
  {
   "type": "mcq",
   "difficulty": "hard",
   "prompt": "Using that class, what is the probability a random student plays neither?",
   "choices": [
    "$\\dfrac{5}{30}$",
    "$\\dfrac{25}{30}$",
    "$\\dfrac{12}{30}$",
    "$0$"
   ],
   "answer": "A",
   "explanation": "$30 - 25 = 5$ students play neither, so the probability is $\\dfrac{5}{30} = \\dfrac{1}{6}$."
  },
  {
   "type": "mcq",
   "difficulty": "medium",
   "prompt": "What is the probability of an impossible event?",
   "choices": [
    "$0$",
    "$1$",
    "$0.5$",
    "$-1$"
   ],
   "answer": "A",
   "explanation": "No favorable outcomes gives $\\dfrac{0}{n} = 0$."
  },
  {
   "type": "mcq",
   "difficulty": "hard",
   "prompt": "Rolling two dice, what is $P(\\text{sum} = 7)$?",
   "choices": [
    "$\\dfrac{1}{6}$",
    "$\\dfrac{1}{12}$",
    "$\\dfrac{7}{36}$",
    "$\\dfrac{1}{9}$"
   ],
   "answer": "A",
   "explanation": "$\\dfrac{6}{36} = \\dfrac{1}{6}$ — the most likely sum."
  },
  {
   "type": "mcq",
   "difficulty": "hard",
   "prompt": "A survey table shows $40$ students: $22$ girls, of whom $10$ take art; $18$ boys, of whom $6$ take art. What is $P(\\text{art})$?",
   "choices": [
    "$\\dfrac{16}{40}$",
    "$\\dfrac{10}{40}$",
    "$\\dfrac{22}{40}$",
    "$\\dfrac{6}{40}$"
   ],
   "answer": "A",
   "explanation": "$10 + 6 = 16$ art students out of $40$."
  },
