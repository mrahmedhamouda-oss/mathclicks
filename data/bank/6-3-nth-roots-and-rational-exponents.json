   "prompt": "Simplify ±√(25x⁴).",
   "choices": [
    "5x²",
    "±5x²",
    "±5|x|²",
    "±25x²"
   ],
   "answer": "B",
   "explanation": "25x⁴ = (5x²)², and the ± in front indicates both square roots."
  },
  {
   "type": "mcq",
   "prompt": "Simplify ⁴√(81x⁴).",
   "choices": [
    "3x",
    "3|x|",
    "9|x|",
    "±3x"
   ],
   "answer": "B",
   "explanation": "81x⁴ = (3x)⁴. Even index with an odd resulting power requires absolute value bars: 3|x|."
