  {
   "type": "mcq",
   "prompt": "How many real nth roots does b have when b < 0 and n is even?",
   "choices": [
    "0",
    "1",
    "2",
    "infinitely many"
   ],
   "answer": "A",
   "explanation": "An even power of a real number is never negative, so there are no real roots — the roots are imaginary."
