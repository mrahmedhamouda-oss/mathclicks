   ],
   "answer": "A",
   "explanation": "Distribute: $\\sqrt{12} + \\sqrt{20} = 2\\sqrt{3} + 2\\sqrt{5}$. Simplest form means simplifying each radical afterwards."
  },
  {
   "type": "mcq",
   "difficulty": "medium",
   "prompt": "Simplify $(\\sqrt{5} + 2)(\\sqrt{5} - 2)$.",
