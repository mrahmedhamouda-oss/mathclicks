   ],
   "answer": "A",
   "explanation": "$(3\\sqrt{2})^{2} = 3^{2}(\\sqrt{2})^{2} = 9 \\cdot 2 = 18$. Square the coefficient as well as the radical."
  },
  {
   "type": "mcq",
   "difficulty": "medium",
   "prompt": "Expand $\\sqrt{2}\\left(\\sqrt{6} + \\sqrt{10}\\right)$.",
